{
  "name": "small-state-react",
  "version": "0.1.0",
  "description": "React and Jotai bindings for small-state, a lightweight state machine library.",
  "author": "qyvvy",
  "license": "MIT",
  "repository": "github:qyvvy/small-state",
  "keywords": ["small-state", "react", "jotai"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./jotai": {
      "import": {
        "types": "./dist/jotai.d.mts",
        "default": "./dist/jotai.mjs"
      },
      "require": {
        "types": "./dist/jotai.d.cts",
        "default": "./dist/jotai.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "THIRD_PARTY_LICENSES.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "use-sync-external-store": "^1.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@happy-dom/global-registrator": "^21.0.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.3.0",
    "@types/use-sync-external-store": "^1.7.0",
    "chalk": "^6.0.1",
    "jotai": "^3.0.1",
    "react": "^19.3.1",
    "small-state": "^0.3.0",
    "tsdown": "^0.23.0",
    "typescript": "~5.8.3"
  },
  "peerDependencies": {
    "small-state": "^0.3.0",
    "react": "^18.0.0 || ^19.0.0",
    "jotai": "^3.0.1"
  },
  "peerDependenciesMeta": {
    "jotai": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/jotai.ts --format esm,cjs --dts",
    "compile": "bun run build",
    "typecheck": "tsc --noEmit",
    "prepack": "bun typecheck && bun compile"
  },
  "sideEffects": false
}
